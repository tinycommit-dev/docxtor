{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@docxtor/core": ["../core/dist/index.d.ts"],
      "@docxtor/extensions": ["../extensions/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}
